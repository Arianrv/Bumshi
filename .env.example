# Bumshi control-plane (bumshid) configuration.
# Copy to `.env` and adjust. Every variable is optional; defaults are shown.

# Deployment mode: development | production
BUMSHI_ENV=production

# Control-plane listener. Keep bound to localhost; Caddy fronts it on 443.
BUMSHI_LISTEN_ADDR=127.0.0.1:8080

# Prometheus metrics listener. Keep on localhost; never expose publicly.
BUMSHI_METRICS_ADDR=127.0.0.1:9090

# Log level: debug | info | warn | error
BUMSHI_LOG_LEVEL=info

# Log format: json | text. Default: text in development, json in production.
# BUMSHI_LOG_FORMAT=json

# Per-request access logging.
# MUST remain false for public releases (privacy: RAM-only, no logs).
# Enable only while developing or debugging.
BUMSHI_ACCESS_LOG=false

# HTTP timeouts (Go duration syntax, e.g. 15s, 2m).
BUMSHI_READ_TIMEOUT=15s
BUMSHI_READ_HEADER_TIMEOUT=10s
BUMSHI_WRITE_TIMEOUT=30s
BUMSHI_IDLE_TIMEOUT=120s
BUMSHI_SHUTDOWN_TIMEOUT=20s

# --- Web proxy engine (mounted under /p/) ---

# Enable the generic web proxy. Off by default during early rollout.
BUMSHI_PROXY_ENABLED=false

# Max size (bytes) of an HTML/CSS body buffered for URL rewriting. Larger text
# bodies are truncated at this limit; non-text bodies always stream unbuffered.
BUMSHI_PROXY_REWRITE_MAX_BYTES=8388608

# How long to wait for an upstream's response headers (the body then streams).
BUMSHI_PROXY_RESPONSE_HEADER_TIMEOUT=30s

# Dial upstreams over IPv4 only. IPv6 egress is unreliable on some networks
# (notably from Iran); leave true unless you specifically need IPv6 targets.
BUMSHI_PROXY_FORCE_IPV4=true

# Gate the proxy behind a valid, unexpired access token (clients send it as the
# bumshi_access cookie). With this off the proxy is an OPEN RELAY: anyone who
# learns your domain can route traffic through your IP. Leave it on.
BUMSHI_PROXY_REQUIRE_TOKEN=true

# Acknowledges running the proxy with no access control at all. Without it, an
# enabled proxy that does not require a token refuses to start rather than
# quietly serving the whole internet.
BUMSHI_PROXY_ALLOW_OPEN_RELAY=false

# Where the access-user roster is persisted so it survives restarts. On the
# systemd unit this lives under StateDirectory (/var/lib/bumshi). Empty = do not
# persist (RAM-only). What users browse is never written here.
BUMSHI_ACCESS_STORE_PATH=/var/lib/bumshi/access.json

# --- Admin panel (deployer-only; its own listener, never the proxy origin) ---

# Enable the admin panel.
BUMSHI_ADMIN_ENABLED=false

# The panel's own listener. It MUST NOT be the control-plane listener: sharing
# an origin with proxied content lets any site a user opens through the proxy
# call the panel's API with your session cookie attached (same-site rules do not
# help — it is literally the same site). Localhost by default; reach it with
# "ssh -N -L 8081:127.0.0.1:8081 you@server", or give it a hostname of its own
# in Caddy if you want it on the web.
BUMSHI_ADMIN_ADDR=127.0.0.1:8081

# Base path for the panel (ideally a secret path, not the default).
BUMSHI_ADMIN_PATH=/admin/

# Admin login name.
BUMSHI_ADMIN_USERNAME=admin

# Password hash. Generate with: bumshid hash-password
# If left empty while the panel is enabled, a random password is generated at
# startup and printed once to the logs.
BUMSHI_ADMIN_PASSWORD_HASH=

# Base URL end users connect to (used to build access connection links).
# Required when the admin panel is enabled, and must be an absolute http(s) URL.
BUMSHI_PUBLIC_URL=

# Password hash is REQUIRED when the panel is enabled: the service refuses to
# start the panel without one rather than generating a credential and printing
# it into the logs, where it would outlive the session it was meant for.
