[Unit]
Description=Bumshi control-plane (bumshid)
Documentation=https://github.com/bumshi/bumshi
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=bumshi
Group=bumshi
EnvironmentFile=/etc/bumshi/bumshi.env
ExecStart=/usr/local/bin/bumshid
Restart=on-failure
RestartSec=2

# --- Hardening (aligns with the RAM-only privacy model) ---
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
ProtectClock=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectHostname=true
RestrictNamespaces=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM
# Persist ONLY the access-user roster (survives restarts). Browsing is never
# written to disk. StateDirectory creates /var/lib/bumshi owned by this service
# and adds it to the writable set even under ProtectSystem=strict.
StateDirectory=bumshi
StateDirectoryMode=0700
ReadWritePaths=

[Install]
WantedBy=multi-user.target
